# ResonanceDB API Environment Variables
# Copy this file to .env and configure for your environment

# Application
APP_NAME=ResonanceDB API
APP_VERSION=1.0.0
DEBUG=true

# Database (Async PostgreSQL)
# For local dev with Docker: postgresql+asyncpg://resonance:resonance_dev@localhost:5432/resonancedb
# For local dev with SQLite: sqlite+aiosqlite:///./resonancedb.db
# For production: postgresql+asyncpg://user:pass@host:5432/db
DATABASE_URL=postgresql+asyncpg://resonance:resonance_dev@localhost:5432/resonancedb

# Security
# REQUIRED: Generate with: openssl rand -hex 32
API_KEY_SECRET=<REQUIRED-generate-with-openssl-rand-hex-32>

# Rate Limiting (requests per hour by tier)
RATE_LIMIT_STARTER=100
RATE_LIMIT_BRONZE=500
RATE_LIMIT_SILVER=2000
RATE_LIMIT_GOLD=10000

# Redis (Optional for local dev, Required for production)
# Redis URL format: redis://[:password]@host:6379[/db]
# If not set, uses in-memory storage (not suitable for production)
REDIS_URL=

# S3 (Optional - for raw data archival)
# S3_BUCKET=resonancedb-samples
# S3_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your_key
# AWS_SECRET_ACCESS_KEY=your_secret

# CORS
# For local dev: ["http://localhost:3000","http://localhost:8000"]
# For production: ["https://resonancedb.aiqra.ai","https://api.resonancedb.aiqra.ai"]
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# NextAuth (for OAuth)
# Generate NEXTAUTH_SECRET with: openssl rand -base64 32
NEXTAUTH_SECRET=<generate-with-openssl-rand-base64-32>
NEXTAUTH_URL=http://localhost:3000

# OAuth Providers (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
